# Oracle Database Configuration
ORACLE_CONNECTION_STRING=accessonedev_high
ORACLE_USER=ACCESSONE_APP
ORACLE_PASSWORD=
ORACLE_WALLET_PASSWORD=
TNS_ADMIN=

# Session Security (required — a long random string, same value on every server instance)
SESSION_SECRET=

# Brevo Email (required for password reset emails)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AccessOne

# Server Configuration
PORT=3000
NODE_ENV=production

# Business timezone for pass validity dates and the daily lifecycle job (00:05 local)
APP_TIMEZONE=Asia/Qatar

# First platform owner (power_admin). Used ONLY when no power_admin exists yet.
# Set both, start the server once, then remove BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Shown on company welcome packages
VENDOR_NAME=
SUPPORT_CONTACT=
